{
    "name": "mailbreeze/mailbreeze-php",
    "description": "Official PHP SDK for MailBreeze - Email Marketing & Transactional Email Platform",
    "keywords": ["mailbreeze", "email", "marketing", "transactional", "smtp", "api"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "MailBreeze",
            "email": "support@mailbreeze.com"
        }
    ],
    "homepage": "https://github.com/MailBreeze/mailbreeze-php",
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0",
        "psr/http-client": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "php-cs-fixer/shim": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "MailBreeze\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MailBreeze\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-html=coverage",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "analyse": "phpstan analyse src tests --level=8"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable"
}
